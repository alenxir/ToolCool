{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toolcool",
  "main": "src/worker.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
